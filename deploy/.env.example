[TEMPLATE]
# Production env for docker-compose.prod.yml (zapit.innotel.us)
# Copy to .env next to the compose file — on the APP host — and fill in.
# The NPM proxy host (on the separate NPM box) is configured in NPM's UI/API,
# not here: no NPM_* vars are needed on the app host.

# Admin password for https://zapit.innotel.us/admin (required)
ADMIN_PASSWORD=change-me

# Authentik SSO — required before you can flip "Require Authentik login"
# (leave empty for zero-login mode)
AUTHENTIK_BASE_URL=
AUTHENTIK_SLUG=zapit
AUTHENTIK_CLIENT_ID=zapit
# Leave empty: the blueprint creates a public PKCE client
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_SCOPES=openid profile email

# QR code customization — link address the QR code encodes (optional).
# Leave empty to use PUBLIC_URL (or the LAN URL).
# Live value: https://zapit.innotel.us/?room=zap-421
QR_URL=

# Initial kill-switch state (then managed from /admin; persisted on the volume)
AUTH_ENABLED=false
