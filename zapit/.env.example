[TEMPLATE]
# zapit configuration example — copy to .env and adjust.
# Used by docker-compose via env_file, or `export` before `npm start`.

PORT=5150
HOST=0.0.0.0

# Admin password for /admin (required to manage the auth kill-switch remotely)
ADMIN_PASSWORD=change-me

# Authentik SSO (optional). Leave empty for zero-login mode.
AUTHENTIK_BASE_URL=
AUTHENTIK_SLUG=zapit
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_SCOPES=openid profile email

# Canonical public origin. Overrides the QR/LAN URLs and pins the OIDC redirect URI
# (PUBLIC_URL + /api/auth/callback must be whitelisted on the Authentik provider).
PUBLIC_URL=https://zapit.innotel.us

# QR code customization — link address the QR code encodes (optional).
# Leave empty to use PUBLIC_URL (or the LAN URL).
QR_URL=

# Initial state of the "require Authentik login" switch (persisted in data/state.json)
AUTH_ENABLED=false

# Where state/config persist (inside the container this is /data)
ZAPIT_DATA_DIR=./data
