# zapit configuration example — copy to .env and adjust.
# Used by docker-compose via env_file, or `export` before `npm start`.

PORT=5150
HOST=0.0.0.0

# Break-glass admin password for /admin. The primary way into the panel is
# Cerulean Authentik SSO (see ZAPIT_ADMIN_GROUPS); this password is the way back
# in when Authentik cannot issue a session at all.
ADMIN_PASSWORD=change-me

# Authentik SSO (optional). Leave empty for zero-login mode.
AUTHENTIK_BASE_URL=
AUTHENTIK_SLUG=zapit
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_SCOPES='openid profile email'

# Which Authentik groups may reach /admin through SSO (comma-separated, exact
# match). Authentik's `profile` scope carries the `groups` claim; a session that
# is not in one of these is authenticated but not an admin, so signing in alone
# never opens the panel. The bearer ADMIN_PASSWORD path is unaffected.
ZAPIT_ADMIN_GROUPS=cerulean-platform

# Canonical public origin. Overrides the QR/LAN URLs and pins the OIDC redirect URI
# (PUBLIC_URL + /api/auth/callback must be whitelisted on the Authentik provider).
PUBLIC_URL=https://zapp.innotel.us

# QR code customization — link address the QR code encodes (optional).
# Leave empty to use PUBLIC_URL (or the LAN URL).
QR_URL=

# Initial state of the "require Authentik login" switch (persisted in data/state.json)
AUTH_ENABLED=false

# Where state/config persist (inside the container this is /data)
ZAPIT_DATA_DIR=./data

# ─── Cerulean Vault (SecretOps) ────────────────────────────────────
# The platform's secret store is Cerulean Vault (HashiCorp Vault, KV v2); the
# repo-root .env carries the same contract (scripts/setup.sh copies
# .env.example from the app dir). ADMIN_PASSWORD / AUTHENTIK_CLIENT_SECRET may
# be `vault://<mount>/<path>#<key>` references, resolved at startup by
# zapit/vault.js:
#
#   ADMIN_PASSWORD=vault://cerulean/zapit#ADMIN_PASSWORD
#
# Set VAULT_ADDR and either VAULT_TOKEN or VAULT_TOKEN_FILE to enable
# resolution; with neither, plain values are used as-is.
VAULT_ADDR=
VAULT_TOKEN_FILE=./data/vault/token/zapit.token
VAULT_PREFIX=cerulean
VAULT_PATH=zapit
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_SKIP_VERIFY=
VAULT_CACERT=
