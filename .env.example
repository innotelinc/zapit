# zapit — platform environment (repo root).
# The app's own config lives in zapit/.env (see zapit/.env.example); this
# root .env carries the Innotel Platform Stack contract: secrets live in
# Cerulean Vault (SecretOps, HashiCorp Vault KV v2).

# ─── Cerulean Vault (SecretOps) ────────────────────────────────────
# Values live in Vault, and .env may name one with a reference:
#
#   ADMIN_PASSWORD=vault://cerulean/zapit#ADMIN_PASSWORD
#
# zapit/vault.js resolves those references at startup, so every consumer reads
# the plain value. A reference that cannot be resolved fails the boot rather
# than starting with a literal `vault://` value, and a leftover `infisical://`
# value is refused (Infisical is retired here).
#
# Cerulean mints this stack's path-scoped token (VAULT_PRODUCT_TOKENS=zapit
# there) and writes it to ./data/vault/token/zapit.token; copy that file in,
# then move any plaintext values across with scripts/vault-migrate.py:
#
#   VAULT_ADDR=http://<cerulean-host>:8200 \
#     VAULT_TOKEN_FILE=./data/vault/token/zapit.token \
#     VAULT_PREFIX=cerulean VAULT_PATH=zapit \
#     python3 scripts/vault-migrate.py --from-env-file .env \
#       --keys ADMIN_PASSWORD,AUTHENTIK_CLIENT_SECRET
VAULT_ADDR=
VAULT_TOKEN_FILE=./data/vault/token/zapit.token
VAULT_PREFIX=cerulean
VAULT_PATH=zapit
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_SKIP_VERIFY=
VAULT_CACERT=

# --- Cerulean (TrustOps — DNS / NPM hosts / TLS / Authentik SSO) ------------
# Cerulean provisions the public DNS names, NPM proxy hosts, and TLS
# certificates for every Innotel platform, and hosts the Authentik SSO
# (OIDC) identity provider used by zapit sign-in.
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ADMIN_PASSWORD=change-me-cerulean-admin
CERULEAN_ZONE=innotel.us
